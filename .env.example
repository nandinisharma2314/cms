# Copy to .env for docker compose. Every value is required.

# The database (the "db" service). Use long random passwords, e.g. `openssl rand -hex 24`.
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Host ports the services are published on.
API_PORT=5000
ADMIN_PORT=3001
PORTAL_PORT=3000

# The API's URL as browsers reach it; baked into both web apps when they are built.
# Add the two web apps' URLs to CORS_ORIGINS in backend/.env as well.
PUBLIC_API_URL=http://localhost:5000
