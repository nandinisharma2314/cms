# =============================================================================
# Complaint Management System — Environment Configuration (.env)
# =============================================================================
# Quickstart:
#   cp .env.example .env
#   docker compose up --build -d
#
# Docker will automatically configure the database, run migrations, bootstrap
# all system defaults, create the Super Admin user, and start all services.
# =============================================================================

# --- Database (MariaDB container) --------------------------------------------
DB_NAME=cms
DB_USER=cms
DB_PASSWORD=cms_secure_password_123
DB_ROOT_PASSWORD=mariadb_root_password_456

# --- Host Ports & Public URLs ------------------------------------------------
API_PORT=5000
FRONTEND_PORT=3000
PUBLIC_API_URL=http://localhost:5000

# --- Initial Super Admin Account ---------------------------------------------
# Created automatically on first deployment. You can sign in immediately at /login.
SUPERADMIN_EMAIL=admin@kvontech.com
SUPERADMIN_PASSWORD=Admin@12345
SUPERADMIN_NAME=Super Admin
SUPERADMIN_MOBILE=

# --- Security & Tokens -------------------------------------------------------
# At least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_super_secret_jwt_key_at_least_32_characters_long
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Messaging & OTP Delivery (Optional) -------------------------------------
# Options for delivery: console | smtp | twilio | off
SMS_DELIVERY=console
EMAIL_DELIVERY=console

# Twilio (when SMS_DELIVERY=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# SMTP (when EMAIL_DELIVERY=smtp)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# --- Object Storage (Optional Cloudflare R2 / S3) ---------------------------
# Default is 'local' saving to uploads directory
STORAGE_BACKEND=local
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
