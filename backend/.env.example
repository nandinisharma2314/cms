# Copy to backend/.env and fill in every value. All variables are required:
# the app refuses to start and names the first missing or invalid one.
# Business settings (organisation name, phone format, attachment limits, ...)
# are not configured here but in the admin panel under Settings.

# development | test | production
APP_ENV=development
# SQLAlchemy URL of the MySQL/MariaDB database.
DATABASE_URI=mysql+pymysql://cms:CHANGE_ME@localhost:3306/cms?charset=utf8mb4

# --- HTTP ------------------------------------------------------------------
# Exact origins of the admin panel and the end-user portal, comma separated.
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# Refresh tokens are kept in an httpOnly cookie. Use COOKIE_SECURE=true behind HTTPS
# (required in production); COOKIE_SAMESITE=none needs COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie; set a parent domain (e.g. example.com) when
# the API and the frontends are on different subdomains.
COOKIE_DOMAIN=
# Read by uvicorn, not the app: behind a reverse proxy, the proxy's address, so
# rate limits see each client's real IP (X-Forwarded-For). Uvicorn trusts only 127.0.0.1 without it.
# FORWARDED_ALLOW_IPS=10.0.0.5

# --- Tokens ----------------------------------------------------------------
# At least 32 characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
ATTACHMENT_URL_TTL_SECONDS=900

# --- One-time passwords and outgoing messages ------------------------------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
# true returns the code in the API response (development only; refused in production).
EXPOSE_DEV_OTP=false
# How sign-in codes and complaint updates go out, per channel:
#   console        write them to the log (development only; refused in production)
#   twilio / smtp  send them through the provider below
#   off            don't use the channel (no sign-in or messages on it); at least one must be on
SMS_DELIVERY=console
EMAIL_DELIVERY=console
MESSAGE_MAX_ATTEMPTS=5
# Needed when either channel uses a provider:
# MESSAGE_TIMEOUT_SECONDS=15
# Needed when SMS_DELIVERY=twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# Needed when EMAIL_DELIVERY=smtp (SMTP_SECURITY: starttls, ssl or none; username/password may both be empty):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Abuse protection -------------------------------------------------------
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPTS_PER_IP_PER_HOUR=100
OTP_REQUESTS_PER_TARGET_PER_HOUR=5
OTP_REQUESTS_PER_IP_PER_HOUR=30
OTP_VERIFICATIONS_PER_IP_PER_HOUR=60
RESET_REQUESTS_PER_IP_PER_HOUR=5

# --- Files, imports, exports ------------------------------------------------
# Attachments are stored here (relative paths are relative to backend/). Never web-served directly.
UPLOAD_DIR=uploads
MAX_CSV_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=50000
IMPORT_SIMILAR_NAME_RATIO=0.85
AUDIT_EXPORT_MAX_ROWS=50000

# --- Background work ---------------------------------------------------------
# Seconds between runs of the in-process worker (SLA checks, message delivery,
# routing retries, cleanup). 0 disables it; then run `python worker.py`.
WORKER_INTERVAL_SECONDS=60
IMPORT_ISSUE_RETENTION_DAYS=30
# 0 keeps audit entries forever.
AUDIT_RETENTION_DAYS=0
