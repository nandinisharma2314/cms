# development | production. Development prints OTPs and returns them in the API response;
# production sends them by SMS (Twilio) or email (SMTP) using the settings below.
APP_ENV=development
# Required outside development. Use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET_KEY=
# DATABASE_URI=sqlite:///./app.db
DATABASE_URI=mysql+pymysql://devuser:password@mysql_db:3306/cms
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30
REOPEN_WINDOW_DAYS=7
MAX_REOPENS=3
SLA_CHECK_INTERVAL_SECONDS=60
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMS_COUNTRY_CODE=+91
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
